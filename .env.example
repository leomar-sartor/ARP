ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:443;http://+:80
JWT_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION_HOURS=8
CONNECTION_STRING=Host=HOST;Database=DB;Username=USER;Password=PASSWORD;SSL Mode=Require
KEY_HMAC=replace-with-hmac-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Never commit .env or real secrets.
# Run by Docker: docker run -p 4290:4290 -p 443:443 -p 80:80 -v .:/app --name=arpapi --env-file .env.example -d arpapi:latest